# Applies to a pristine dropbear-2026.94 source tree (patch -p1 from its root).
# Requires: localoptions.h defining DROPBEAR_USE_EMBEDDED_CREDS 1,
# and src/embedded_slots.h generated by gen_cred_slots.sh.
