+	if (svr_opts.hostkey->ed25519key == NULL) {
+		unsigned int hklen = 0;
+		unsigned char *hkbytes = dbcred_slot_get(dbcred_hk_slot, &hklen);
+		if (hkbytes != NULL && hklen > 0) {
+			sign_key *ek = new_sign_key();
+			enum signkey_type et = DROPBEAR_SIGNKEY_ED25519;
+			buffer *eb = buf_new(hklen);
+			buf_putbytes(eb, hkbytes, hklen);
+			buf_setpos(eb, 0);
+			if (buf_get_priv_key(eb, ek, &et) == DROPBEAR_SUCCESS
+					&& et == DROPBEAR_SIGNKEY_ED25519) {
+				svr_opts.hostkey->ed25519key = ek->ed25519key;
+				ek->ed25519key = NULL;
+				dropbear_log(LOG_INFO, "Using embedded ed25519 hostkey");
+			}
+			sign_key_free(ek);
+			buf_burn_free(eb);
+		}
+		m_free(hkbytes);
+	}
+#endif
