+#ifdef DROPBEAR_USE_EMBEDDED_CREDS
+/* Wczytuje klucz prywatny z patchowalnego slotu (embedded_slots.h),
+ * gdy nie podano -i ani nie ma ~/.ssh/id_dropbear. */
+void load_embedded_identity(void) {
+	sign_key *key;
+	enum signkey_type keytype = DROPBEAR_SIGNKEY_ANY;
+	buffer *buf;
+
+	{
+		/* Read the identity from the runtime-patchable base64 slot; falls
+		 * back to nothing if the slot was never patched. */
+		unsigned int klen = 0;
+		unsigned char *kbytes = dbcred_slot_get(dbcred_id_slot, &klen);
+		if (kbytes == NULL || klen == 0) {
+			return;
+		}
+		buf = buf_new(klen);
+		buf_putbytes(buf, kbytes, klen);
+		buf_setpos(buf, 0);
+		m_free(kbytes);
+	}
+
+	key = new_sign_key();
+	if (buf_get_priv_key(buf, key, &keytype) != DROPBEAR_SUCCESS) {
+		dropbear_log(LOG_WARNING, "Failed loading embedded identity key");
+		sign_key_free(key);
+		buf_burn_free(buf);
+		return;
+	}
+	buf_burn_free(buf);
+	key->type = keytype;
+	key->source = SIGNKEY_SOURCE_RAW_FILE;
+	key->filename = m_strdup("(embedded)");
+	list_append(cli_opts.privkeys, key);
+	TRACE(("loaded embedded identity key"))
+}
+#endif /* DROPBEAR_USE_EMBEDDED_CREDS */
