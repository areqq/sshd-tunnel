# Strip everything DSVPN does to the system behind the operator's back, on
# both the server and the client side.
#
# Upstream is built for "route all my traffic through the VPN": the client
# sets a congestion-control sysctl, installs an iptables rule and hijacks the
# default route into a policy routing table; the server turns on ip_forward
# and installs NAT/MASQUERADE plus FORWARD rules. That is the right default
# for its own use case and the wrong one here — this project wants the device
# reachable, not its traffic redirected, exactly like the reverse-SSH and
# OpenVPN modes.
#
# It is also a portability problem, and a fatal one: any command in these
# lists that fails aborts dsvpn (vpn.c bails on the first failure). Neither
# end can rely on them —
#   - the server runs in a chroot that has no iptables at all,
#   - `sysctl ...=bbr` needs kernel >= 4.9 plus the module, and one router
#     here runs 4.1,
#   - `iptables -t raw ... -m addrtype` needs tables and matches that minimal
#     OpenWrt/ASUSWRT builds often leave out,
#   - `ip -6 addr add` fails outright where IPv6 is disabled.
#
# What is left is the irreducible minimum for a point-to-point tunnel: bring
# the interface up and give it its pair of addresses. Nothing else on either
# machine is touched, so there is also nothing to unset on exit.
#
# The vpn.c hunk follows from the os.c one. Once the Linux command lists no
# longer mention $EXT_GW_IP or $EXT_IF_NAME, refusing to start because neither
# could be detected is a check with nothing left behind it — and it does fire
# in practice, since both are read out of `ip route show default`, which
# prints nothing in a chroot or on a host whose only route is the tunnel's.
# The check is kept for the BSD/macOS branches, where those two values are
# still substituted into real commands.
--- a/src/os.c
+++ b/src/os.c
@@ -445,26 +445,10 @@
     if (is_server) {
 #ifdef __linux__
         static const char *set_cmds
-            []   = { "sysctl net.ipv4.ip_forward=1",
-                     "ip addr add $LOCAL_TUN_IP peer $REMOTE_TUN_IP dev $IF_NAME",
-                     "ip -6 addr add $LOCAL_TUN_IP6 peer $REMOTE_TUN_IP6/96 dev $IF_NAME",
+            []   = { "ip addr add $LOCAL_TUN_IP peer $REMOTE_TUN_IP dev $IF_NAME",
                      "ip link set dev $IF_NAME up",
-                     "iptables -t raw -I PREROUTING ! -i $IF_NAME -d $LOCAL_TUN_IP -m addrtype ! "
-                       "--src-type LOCAL -j DROP",
-                     "iptables -t nat -A POSTROUTING -o $EXT_IF_NAME -s $REMOTE_TUN_IP -j MASQUERADE",
-                     "iptables -t filter -A FORWARD -i $EXT_IF_NAME -o $IF_NAME -m state --state "
-                       "RELATED,ESTABLISHED -j ACCEPT",
-                     "iptables -t filter -A FORWARD -i $IF_NAME -o $EXT_IF_NAME -j ACCEPT",
                      NULL },
-   *unset_cmds[] = {
-       "iptables -t nat -D POSTROUTING -o $EXT_IF_NAME -s $REMOTE_TUN_IP -j MASQUERADE",
