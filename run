#!/bin/sh
# Host-side wrapper: prepares the chroot and hands over to /run.sh inside it.
#
#   ./run <port> [password] [options]
#
# Everything after the script name is passed through unchanged; see
# `./run --help` for the option list.
#
# Two things must exist inside the chroot before sshd can start: a mounted
# /proc, and real device nodes for /dev/null and friends (OpenSSL reads
# /dev/urandom). Rather than shipping device nodes in the tarball — which
# would make unpacking as a normal user impossible — the real devices are
# bind-mounted onto placeholder files here, and unmounted on exit.
#
# Environment:
#   SSHD_TUNNEL_PASSWORD     password, keeping it out of the process list
#   SSHD_TUNNEL_SKIP_MOUNTS  set to 1 when /proc and /dev are already prepared
#   SSHD_TUNNEL_IP           override the advertised server addresses

set -eu

PROG='sshd-tunnel'
DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)"
ROOTFS="$DIR/rootfs"
DEVICES='null zero full random urandom tty'

# Which entrypoint inside the chroot to hand over to. --vpn swaps the
# reverse-SSH server for the OpenVPN one and --dsvpn for the DSVPN one;
# /dev/net/tun is only needed then, and bind-mounting it unconditionally would
# fail on a host without the tun module loaded.
ENTRY='/run.sh'
MODE=''

log() { printf '%s: %s\n' "$PROG" "$*" >&2; }
die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

case "${1:-}" in
	-h|--help)
		# Run the entrypoint with the host's shell rather than through chroot:
		# --help exits before the script touches anything inside the rootfs, so
		# this keeps `run --help` working for a user who is not root.
		if [ -f "$ROOTFS/run.sh" ]; then
			exec sh "$ROOTFS/run.sh" --help
		fi
		printf 'Usage: %s <port> [password] [options]\n' "$0"
		printf '       %s --vpn [options]\n' "$0"
		printf '       %s --dsvpn [options]\n' "$0"
		exit 0
		;;
	--vpn|--dsvpn)
		# Deliberately not shifted here. The privilege check below re-executes
		# the whole command line under sudo, and consuming the mode flag first
		# would drop it from that re-exec — so `./run --vpn` as a normal user
		# would come back as a bare `./run` and silently start the reverse-SSH
		# mode instead. It is shifted once no further re-exec can happen.
		MODE="$1"
		case "$MODE" in
			--vpn)   ENTRY='/vpn.sh' ;;
			--dsvpn) ENTRY='/dsvpn.sh' ;;
		esac
		DEVICES="$DEVICES net/tun"
		case "${2:-}" in
			-h|--help)
				if [ -f "$ROOTFS$ENTRY" ]; then
					exec sh "$ROOTFS$ENTRY" --help
				fi
				printf 'Usage: %s %s [options]\n' "$0" "$MODE"
				exit 0
				;;
		esac
		[ -e /dev/net/tun ] || die 'no /dev/net/tun on this host — load the tun module (modprobe tun)'
		;;
esac

[ -d "$ROOTFS" ] || die "no rootfs at $ROOTFS — run this from an unpacked release"
[ -x "$ROOTFS$ENTRY" ] || die "$ROOTFS$ENTRY is missing or not executable"

# ---------------------------------------------------------------- privileges
if [ "$(id -u)" -ne 0 ]; then
	if command -v sudo >/dev/null 2>&1; then
		log 're-executing under sudo (chroot needs root)'
		exec sudo -E "$0" "$@"
	fi
	die 'must run as root: chroot and bind mounts require it'
fi

# Past the last possible re-exec, so the mode flag has done its job and must
# not reach the entrypoint, which does not know it.
if [ -n "$MODE" ]; then
	shift
fi

# -------------------------------------------------------------------- mounts
MOUNTED=''

is_mounted() {
	# /proc/mounts is authoritative and always present on Linux; mountpoint(1)
	# is not installed everywhere.
	awk -v t="$1" '$2 == t { found = 1 } END { exit !found }' /proc/mounts 2>/dev/null
}

cleanup() {
	trap - EXIT INT TERM HUP
	set +e
	# The chroot's own /run.sh stops sshd and the bootstrap server from its
	# trap, but it only gets the chance if it is signalled first; the mounts
	# stay busy until it is gone.
	if [ -n "${CHILD:-}" ]; then
		kill "$CHILD" 2>/dev/null
		wait "$CHILD" 2>/dev/null
	fi
	for target in $MOUNTED; do
		# A plain umount can fail while the just-signalled sshd still holds a
		# reference, so retry briefly before resorting to a lazy detach, which
		# leaves the mount visible until the last reference goes away.
		attempt=0
		while [ "$attempt" -lt 3 ]; do
			umount "$target" 2>/dev/null && break
			attempt=$((attempt + 1))
			sleep 1
		done
		is_mounted "$target" && umount -l "$target" 2>/dev/null
	done
}

prepare_mounts() {
	trap cleanup EXIT INT TERM HUP

	mkdir -p "$ROOTFS/proc" "$ROOTFS/dev"

	# Anything already mounted is adopted rather than skipped: a mount left
	# behind by an earlier run would otherwise never be cleaned up, and a
	# leaked bind mount makes the rootfs impossible to delete or rebuild.
	if is_mounted "$ROOTFS/proc"; then
		MOUNTED="$ROOTFS/proc $MOUNTED"
	else
		mount -t proc proc "$ROOTFS/proc" || die "cannot mount proc on $ROOTFS/proc"
		MOUNTED="$ROOTFS/proc $MOUNTED"
	fi

	for dev in $DEVICES; do
		[ -e "/dev/$dev" ] || continue
		target="$ROOTFS/dev/$dev"
		# The placeholder is a plain file; bind mounts need the target to
		# exist, and net/tun needs its directory to exist first.
		mkdir -p "$(dirname -- "$target")"
		[ -e "$target" ] || : > "$target"
		if is_mounted "$target"; then
			MOUNTED="$target $MOUNTED"
		elif mount --bind "/dev/$dev" "$target"; then
			MOUNTED="$target $MOUNTED"
		else
			die "cannot bind-mount /dev/$dev into the chroot"
		fi
	done
}

if [ "${SSHD_TUNNEL_SKIP_MOUNTS:-0}" = '1' ]; then
	log 'skipping mount setup (SSHD_TUNNEL_SKIP_MOUNTS=1)'
else
	prepare_mounts
fi

# ------------------------------------------------------------ server addresses
if [ -z "${SSHD_TUNNEL_IP:-}" ]; then
	SSHD_TUNNEL_IP="$(ip -4 -o addr show scope global 2>/dev/null |
		awk '{ split($4, a, "/"); printf "%s ", a[1] }')"
	[ -n "$SSHD_TUNNEL_IP" ] || SSHD_TUNNEL_IP="$(hostname -I 2>/dev/null || true)"
fi

# ------------------------------------------------------------------- handover
# A fixed environment: the chroot has its own filesystem layout, so inheriting
# the host's PATH would point at directories that do not exist in there.
env -i \
	PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' \
	HOME='/root' \
	TERM="${TERM:-dumb}" \
	SSHD_TUNNEL_IP="$SSHD_TUNNEL_IP" \
	SSHD_TUNNEL_PASSWORD="${SSHD_TUNNEL_PASSWORD:-}" \
	chroot "$ROOTFS" "$ENTRY" "$@" &

CHILD=$!
wait "$CHILD" || STATUS=$?
exit "${STATUS:-0}"
